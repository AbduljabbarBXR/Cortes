# Cortes mobile — env defaults (all optional; keys can be set in-app instead)
# Anything EXPO_PUBLIC_* is baked into the JS bundle. Do NOT put a real
# production key here — these are build-time defaults only.

# DeepSeek (default provider)
EXPO_PUBLIC_DEEPSEEK_API_KEY=

# Hermes — any OpenAI-compatible host (self-hosted vLLM, Together, your box)
EXPO_PUBLIC_HERMES_BASE_URL=
EXPO_PUBLIC_HERMES_API_KEY=
EXPO_PUBLIC_HERMES_MODEL=

# OpenRouter — free models for trial (:free suffix), one key covers hundreds
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_MODEL=deepseek/deepseek-r1:free
